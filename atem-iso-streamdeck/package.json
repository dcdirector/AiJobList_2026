{
	"name": "atem-iso-streamdeck",
	"version": "0.1.0",
	"description": "Stream Deck plugin for the Blackmagic ATEM Mini Pro ISO",
	"scripts": {
		"build": "rollup -c && npm run build:deps",
		"watch": "npm run build:deps && rollup -c -w --watch.onEnd=\"streamdeck restart com.dcdirector.atem-iso\"",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"icons": "node scripts/make-icons.mjs",
		"validate": "streamdeck validate com.dcdirector.atem-iso.sdPlugin",
		"pack": "npm run build && streamdeck pack com.dcdirector.atem-iso.sdPlugin --force --output release",
		"smoke": "node scripts/smoke.mjs",
		"build:deps": "npm install --omit=dev --install-links --no-audit --no-fund --prefix com.dcdirector.atem-iso.sdPlugin",
		"check": "npm run typecheck && npm test && npm run build && npm run validate && npm run smoke"
	},
	"license": "MIT",
	"dependencies": {
		"@elgato/streamdeck": "^3.0.6",
		"@elgato/utils": "^0.7.0",
		"atem-connection": "^3.11.1"
	},
	"devDependencies": {
		"@elgato/cli": "^1.10.5",
		"@resvg/resvg-js": "^2.6.2",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.2",
		"@rollup/plugin-typescript": "^12.3.1",
		"@types/node": "^26.6.6",
		"rollup": "^4.68.8",
		"tslib": "^2.9.1",
		"typescript": "^5.9.3",
		"vitest": "^5.1.1",
		"ws": "^8.23.0"
	},
	"private": true,
	"type": "module"
}
